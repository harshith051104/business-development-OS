# ================================================================
# ELLY Business Development Portal — Production Configuration
# ================================================================
# Copy to .env and fill in real values before deploying.

APP_NAME=ELLY Business Development Portal
APP_VERSION=1.0.0
DEBUG=false
DATABASE_URL=sqlite:///./bd_portal.db

# ── JWT Security ────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_NEW_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Token Encryption (Fernet) ──────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=CHANGE_ME_GENERATE_NEW_KEY

# ── CORS Origins ───────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# ── LLM Providers ──────────────────────────────────────────────
# At least one required. Priority: Groq > NVIDIA > Gemini
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
GEMINI_API_KEY=

# ── Discovery / Research ───────────────────────────────────────
# At least one required for prospect discovery
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Local Google Maps scraper (organization discovery) ─────────
# Start: docker compose -f ../deployment/google-maps-scraper/docker-compose.yml up -d
# Powered by gosom/google-maps-scraper (MIT). Scraping Google Maps may violate Google's ToS and
# can trigger temporary IP blocks; keep depth low. Treat scraped contact data under GDPR/CCPA.
GMAPS_SCRAPER_ENABLED=true
GMAPS_SCRAPER_URL=http://localhost:8095
GMAPS_SCRAPER_DEPTH=5
GMAPS_SCRAPER_MAX_TIME_SECONDS=90
GMAPS_SCRAPER_EXTRACT_EMAILS=false

# ── Scrapegraph Deep Research ──────────────────────────────────
SCRAPEGRAPH_ENABLED=false

# ── Gmail OAuth2 ───────────────────────────────────────────────
# 1. Create Google Cloud project at https://console.cloud.google.com
# 2. Enable Gmail API
# 3. Create OAuth 2.0 credentials (Desktop App)
# 4. Download JSON → save as google_gmail_credentials.json
# 5. First run opens browser for OAuth consent → token saved automatically
GMAIL_CREDENTIALS_FILE=google_gmail_credentials.json
GMAIL_SENDER_EMAIL=your-email@gmail.com

# ── Google Sheets (Optional) ───────────────────────────────────
# GOOGLE_SHEETS_CREDENTIALS_FILE=google_credentials.json
# GOOGLE_SHEETS_SPREADSHEET_ID=

# ── Google Maps (Optional) ─────────────────────────────────────
# GOOGLE_MAPS_API_KEY=

# ── Google Calendar (Optional) ─────────────────────────────────
# GOOGLE_CALENDAR_CREDENTIALS_FILE=google_calendar_credentials.json
# GOOGLE_CALENDAR_ID=primary
